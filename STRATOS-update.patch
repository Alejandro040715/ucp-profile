+import assert from 'node:assert/strict';
+import { PerspectiveCamera, Quaternion, Vector3 } from 'three';
+import { CameraSystem, type CameraTarget } from '../src/camera/CameraSystem.ts';
+
+const t: CameraTarget = { position: new Vector3(90000, 1600, -90000), quaternion: new Quaternion(),
+  velocity: new Vector3(0, 0, -190), omega: new Vector3(), specificForce: new Vector3(0, 9.81, 0),
+  tas: 190, mach: 0.55, vibration: 3, onGround: false };
+let count = 0;
+function test(name: string, fn: () => void) { fn(); count++; console.log(`PASS ${name}`); }
+test('Severe engine vibration does not rotate the cockpit sight and head displacement stays sub-millimetric', () => {
+  const camera = new PerspectiveCamera(72, 16 / 9, 0.1, 100000), system = new CameraSystem(camera);
+  system.update(1 / 60, t); const orientation = camera.quaternion.clone(), eye = camera.position.clone();
+  for (let i = 0; i < 600; i++) {
+    system.update(1 / 60, t);
+    assert.ok(camera.quaternion.angleTo(orientation) < 1e-7);
+    assert.ok(camera.position.distanceTo(eye) < 0.0015);
+  }
+});
+test('Aiming holds a steady sight even with engine vibration and G loads', () => {
+  const camera = new PerspectiveCamera(), system = new CameraSystem(camera); system.aiming = true;
+  const loaded = { ...t, specificForce: new Vector3(20, 60, -10), omega: new Vector3(0, 0, 0.5) };
+  system.update(1 / 60, loaded); const eye = camera.position.clone(), orientation = camera.quaternion.clone();
+  for (let i = 0; i < 240; i++) {
+    system.update(1 / 60, loaded);
+    assert.ok(camera.position.distanceTo(eye) < 1e-8); assert.ok(camera.quaternion.angleTo(orientation) < 1e-7);
+  }
+});
+console.log(`${count} camera checks passed`);
