+// Fictional training battery: optical acquisition, IR missiles and flare decoys.
+// Gameplay timings/ranges are deliberately arcade values, not real weapon data.
+import { Vector3 } from 'three';
+import type { CombatPose, Target } from './CombatSimulation.ts';
+
+export interface DecoyFlare {
+  id: number;
+  position: Vector3;
+  velocity: Vector3;
+  age: number;
+}
+export interface IncomingMissile {
+  id: number;
+  kind: 'sam';
+  position: Vector3;
+  previous: Vector3;
+  velocity: Vector3;
+  age: number;
+  decoyId: number | null;
+}
+export type DefenseEvent =
+  | { type: 'tracking' }
+  | { type: 'launch' }
+  | { type: 'decoy' }
+  | { type: 'blast'; position: Vector3 }
+  | { type: 'playerHit'; position: Vector3 };
+
+function segmentDistance(a: Vector3, b: Vector3, point: Vector3): number {
+  const line = b.clone().sub(a);
+  const t = Math.max(0, Math.min(1, point.clone().sub(a).dot(line) / Math.max(line.lengthSq(), 1e-9)));
+  return a.clone().addScaledVector(line, t).distanceTo(point);
+}
+
+export class AirDefenseSimulation {
+  enabled = false;
+  lockProgress = 0;
+  readonly missiles: IncomingMissile[] = [];
+  readonly flares: DecoyFlare[] = [];
+  readonly pending: DefenseEvent[] = [];
+  rounds = 4;
+  private cooldown = 8;
+  private serial = 100000;
+  private previousPlayer = new Vector3();
+  private height: (x: number, z: number) => number;
+
+  constructor(height: (x: number, z: number) => number) { this.height = height; }
+
+  reset(pose: CombatPose): void {
+    this.missiles.length = this.flares.length = this.pending.length = 0;
+    this.lockProgress = 0; this.rounds = 4; this.cooldown = 8;
+    this.previousPlayer.copy(pose.position);
+  }
+
+  deploy(position: Vector3, velocity: Vector3): void {
+    this.flares.push({ id: ++this.serial, position, velocity, age: 0 });
+  }
+
+  private clearSight(a: Vector3, b: Vector3): boolean {
+    const samples = Math.max(8, Math.ceil(a.distanceTo(b) / 180));
+    for (let i = 1; i < samples; i++) {
+      const p = a.clone().lerp(b, i / samples);
+      if (p.y < this.height(p.x, p.z) + 2) return false;
+    }
+    return true;
+  }
+
+  step(dt: number, pose: CombatPose, launcher: Target): void {
+    for (let i = this.flares.length - 1; i >= 0; i--) {
+      const f = this.flares[i]; f.age += dt;
+      f.velocity.multiplyScalar(Math.exp(-dt * 0.6)); f.velocity.y -= 9.8 * dt;
+      f.position.addScaledVector(f.velocity, dt);
+      if (f.age >= 4 || f.position.y <= this.height(f.position.x, f.position.z)) this.flares.splice(i, 1);
+    }
+    this.cooldown = Math.max(0, this.cooldown - dt);
+    const origin = launcher.position.clone().add(new Vector3(0, 4, 0));
+    const range = origin.distanceTo(pose.position);
+    const canTrack = this.enabled && launcher.alive && !pose.destroyed && !pose.onGround
+      && range > 180 && range < 8500 && pose.position.y > this.height(pose.position.x, pose.position.z) + 25
+      && pose.position.y - origin.y < 3000 && this.clearSight(origin, pose.position);
+    const wasTracking = this.lockProgress > 0;
+    this.lockProgress = canTrack ? Math.min(1, this.lockProgress + dt / 3) : 0;
+    if (this.lockProgress > 0 && !wasTracking) this.pending.push({ type: 'tracking' });
+    if (this.lockProgress === 1 && this.cooldown === 0 && this.rounds > 0
+      && !this.missiles.some(m => m.decoyId === null)) {
+      const direction = pose.position.clone().addScaledVector(pose.velocity, 1).sub(origin).normalize();
+      this.missiles.push({ id: ++this.serial, kind: 'sam', position: origin, previous: origin.clone(),
+        velocity: direction.multiplyScalar(260), age: 0, decoyId: null });
+      this.rounds--; this.cooldown = 16;
+      this.pending.push({ type: 'launch' });
+    }
+    for (let i = this.missiles.length - 1; i >= 0; i--) {
+      const m = this.missiles[i]; m.age += dt; m.previous.copy(m.position);
+      if (m.decoyId === null && m.position.distanceTo(pose.position) < 1800) {
+        const forward = m.velocity.clone().normalize();
+        const decoy = this.flares.find(f => f.age > 0.12 && f.age < 3.5 && m.position.distanceTo(f.position) < 1900
+          && forward.dot(f.position.clone().sub(m.position).normalize()) > 0.75);
+        if (decoy) { m.decoyId = decoy.id; this.pending.push({ type: 'decoy' }); }
+      }
+      const decoy = this.flares.find(f => f.id === m.decoyId);
+      const aim = m.decoyId === null && !pose.destroyed ? pose.position : decoy?.position;
+      if (aim && m.age < 18) {
+        const velocity = m.decoyId === null ? pose.velocity : decoy!.velocity;
+        const desired = aim.clone().addScaledVector(velocity, Math.min(1.2, m.position.distanceTo(aim) / 800)).sub(m.position).normalize();
+        const speed = Math.min(480, m.velocity.length() + dt * 100);
+        m.velocity.normalize().lerp(desired, 1 - Math.exp(-2.6 * dt)).normalize().multiplyScalar(speed);
+      } else m.velocity.y -= 9.8 * dt;
+      m.position.addScaledVector(m.velocity, dt);
+      // Sweep relative to the aircraft, so fast crossings cannot tunnel through it.
+      const a = m.previous.clone().sub(this.previousPlayer), b = m.position.clone().sub(pose.position);
+      const hit = !pose.destroyed && !pose.onGround && segmentDistance(a, b, new Vector3()) < 12;
+      const decoyHit = decoy && segmentDistance(m.previous, m.position, decoy.position) < 9;
+      const ground = m.position.y <= this.height(m.position.x, m.position.z);
+      if (hit) this.pending.push({ type: 'playerHit', position: pose.position.clone() });
+      else if (decoyHit || ground || m.age > 22) this.pending.push({ type: 'blast', position: m.position.clone() });
+      if (hit || decoyHit || ground || m.age > 22) this.missiles.splice(i, 1);
+    }
+    this.previousPlayer.copy(pose.position);
+  }
+}
