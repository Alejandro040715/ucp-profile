+import assert from 'node:assert/strict';
+import { Quaternion, Vector3 } from 'three';
+import { CombatSimulation, type CombatPose } from '../src/combat/CombatSimulation.ts';
+
+const pose = (): CombatPose => ({ position: new Vector3(0, 1600, 0), quaternion: new Quaternion(),
+  velocity: new Vector3(0, 0, -190), onGround: false, destroyed: false });
+const fresh = (height = (_x: number, _z: number) => 0) => {
+  const p = pose(), sim = new CombatSimulation(height); sim.reset(p); sim.defense.enabled = true;
+  return { p, sim, defense: sim.defense };
+};
+const tick = (sim: CombatSimulation, p: CombatPose, seconds: number) => {
+  for (let i = 0; i < Math.round(seconds * 60); i++) sim.step(1 / 60, p);
+};
+let count = 0;
+function test(name: string, fn: () => void) { fn(); count++; console.log(`PASS ${name}`); }
+
+test('IR battery acquires gradually, gives warning and launches after initial grace period', () => {
+  const { sim, p, defense } = fresh(); tick(sim, p, 1);
+  assert.ok(defense.lockProgress > 0 && defense.lockProgress < 1);
+  assert.equal(defense.pending.filter(e => e.type === 'tracking').length, 1);
+  tick(sim, p, 6); assert.equal(defense.missiles.length, 0);
+  tick(sim, p, 1.2); assert.equal(defense.missiles.length, 1); assert.equal(defense.rounds, 3);
+  tick(sim, p, 3); assert.equal(defense.pending.filter(e => e.type === 'launch').length, 1);
+});
+test('Free flight, ground, destroyed aircraft and terrain cover prevent SAM launches', () => {
+  for (const mode of ['free', 'ground', 'destroyed', 'terrain']) {
+    const { sim, p, defense } = fresh(mode === 'terrain' ? (_x, z) => z < -2000 && z > -4000 ? 2600 : 0 : undefined);
+    if (mode === 'free') defense.enabled = false;
+    if (mode === 'ground') p.onGround = true;
+    if (mode === 'destroyed') p.destroyed = true;
+    tick(sim, p, 20); assert.equal(defense.missiles.length, 0, mode); assert.equal(defense.lockProgress, 0, mode);
+  }
+});
+test('Uncountered missile reaches the aircraft and reports a hit', () => {
+  const { sim, p, defense } = fresh(); tick(sim, p, 30);
+  assert.ok(defense.pending.some(e => e.type === 'playerHit'));
+});
+test('Flares deployed too early expire and do not grant blanket invulnerability', () => {
+  const { sim, p, defense } = fresh(); assert.ok(sim.deployFlares(p)); tick(sim, p, 30);
+  assert.equal(defense.flares.length, 0); assert.ok(defense.pending.some(e => e.type === 'playerHit'));
+  assert.equal(defense.pending.some(e => e.type === 'decoy'), false);
+});
+test('Timely flares divert an approaching missile and a moving aircraft survives', () => {
+  const { sim, p, defense } = fresh();
+  let deployed = false, diverted = false;
+  for (let i = 0; i < 60 * 23; i++) {
+    p.position.addScaledVector(p.velocity, 1 / 60);
+    const incoming = defense.missiles.find(m => m.decoyId === null);
+    if (!deployed && incoming && incoming.position.distanceTo(p.position) < 1600) {
+      assert.ok(sim.deployFlares(p)); deployed = true;
+    }
+    sim.step(1 / 60, p);
+    diverted ||= defense.pending.some(e => e.type === 'decoy');
+    if (diverted && defense.missiles.length === 0) break;
+  }
+  assert.ok(deployed && diverted); assert.equal(sim.flares, 22);
+  assert.equal(defense.pending.some(e => e.type === 'playerHit'), false);
+  assert.equal(defense.missiles.length, 0);
+});
+test('Destroying the launcher prevents new shots while existing missiles remain live', () => {
+  const { sim, p, defense } = fresh(); tick(sim, p, 8.2); sim.targets[4].alive = false;
+  assert.equal(defense.missiles.length, 1); tick(sim, p, 30);
+  assert.equal(defense.pending.filter(e => e.type === 'launch').length, 1); assert.equal(defense.lockProgress, 0);
+});
+test('Swept missile collision handles an aircraft crossing between frames', () => {
+  const { sim, p, defense } = fresh(); defense.enabled = false;
+  defense.missiles.push({ id: 8000, kind: 'sam', position: p.position.clone().add(new Vector3(0, 0, -5)),
+    previous: p.position.clone(), velocity: new Vector3(0, 0, 480), age: 0, decoyId: null });
+  sim.step(1 / 60, p); assert.equal(defense.missiles.length, 0);
+  assert.ok(defense.pending.some(e => e.type === 'playerHit'));
+});
+test('Reset removes hostile missiles, hot decoys, warnings and restores ammunition', () => {
+  const { sim, p, defense } = fresh(); tick(sim, p, 8.2); sim.deployFlares(p); sim.reset(p);
+  assert.equal(defense.missiles.length, 0); assert.equal(defense.flares.length, 0);
+  assert.equal(defense.pending.length, 0); assert.equal(defense.rounds, 4); assert.equal(sim.flares, 24);
+});
+console.log(`${count} defense checks passed`);
