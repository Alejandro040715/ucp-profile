{
  "name": "stratos-flight-demo",
  "version": "1.0.0",
  "private": true,
  "description": "STRATOS \u2014 fictional fighter jet flight simulator vertical slice (Three.js / WebGL2)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test:physics": "node --experimental-strip-types tests/physics.test.ts",
    "shots": "node tests/shot.mjs 0 tests/shots/exterior.js",
    "artifact": "node scripts/textures.mjs && vite build && node scripts/artifact.mjs",
    "textures": "node scripts/textures.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
